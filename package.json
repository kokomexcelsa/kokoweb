{
  "name": "kokoweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-static-assets.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "content:import:speech-list": "node scripts/import-speech-list.mjs",
    "content:import:community": "node scripts/import-community-periods.mjs",
    "assets:brand": "node scripts/create-brand-images.mjs",
    "check:images": "node scripts/check-image-metadata.mjs",
    "check:a11y": "node scripts/check-static-a11y.mjs",
    "check:content": "node scripts/check-content-proof.mjs",
    "check:legacy-urls": "node scripts/check-legacy-urls.mjs",
    "check:links": "node scripts/check-links.mjs",
    "validate": "npm run check && npm run build && npm run check:images && npm run check:a11y && npm run check:content && npm run check:legacy-urls && npm run check:links"
  },
  "dependencies": {
    "astro": "6.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "cheerio": "^1.1.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  }
}
