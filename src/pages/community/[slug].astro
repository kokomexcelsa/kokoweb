---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import CommunityPeriodPage from '../../components/CommunityPeriodPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';

type CommunityEntry = CollectionEntry<'communityPeriods'>;

export async function getStaticPaths() {
  const periods = ((await getCollection('communityPeriods')) as CommunityEntry[])
    .sort((a: CommunityEntry, b: CommunityEntry) => {
      const aTime = a.data.period.end?.getTime() ?? a.data.year ?? 0;
      const bTime = b.data.period.end?.getTime() ?? b.data.year ?? 0;
      return bTime - aTime;
    });

  return periods.map((entry: CommunityEntry) => ({
    params: { slug: entry.data.id },
    props: { period: entry.data }
  }));
}

const { period } = Astro.props as { period: CommunityEntry['data'] };
const site = Astro.site ?? new URL('https://kokomexcelsa.github.io');
const pageUrl = new URL(withBase(period.legacyPath), site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首頁',
      item: new URL(withBase('/index.html'), site).toString()
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '社群活動',
      item: new URL(withBase('/community/community.html'), site).toString()
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: period.title.zh,
      item: pageUrl
    }
  ]
};
---

<BaseLayout
  title={`${period.title.zh} | 大魔術熊貓工程師`}
  description="大魔術熊貓工程師社群活動規畫、管理與協辦紀錄。"
  canonicalPath={period.legacyPath}
  structuredData={structuredData}
>
  <CommunityPeriodPage period={period} />
</BaseLayout>
