---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../utils/format';
import { withBase } from '../utils/url';

type ContributionEntry = CollectionEntry<'contributions'>;

const contributions = ((await getCollection('contributions')) as ContributionEntry[])
  .sort((a: ContributionEntry, b: ContributionEntry) => b.data.date.getTime() - a.data.date.getTime());
const microsoftContributions = contributions.filter((entry) => entry.data.microsoftProducts.length > 0);
const [booksEntry] = await getCollection('books');
const [writingEntry] = await getCollection('writing');
const books = booksEntry.data.books;
const writing = writingEntry.data.items;
const products = [...new Set(microsoftContributions.flatMap((entry) => entry.data.microsoftProducts as string[]))].sort();
const recentMicrosoft = microsoftContributions.slice(0, 12);
---

<BaseLayout
  title="Microsoft AI MVP | 大魔術熊貓工程師"
  description="Ko Ko 大魔術熊貓工程師的 Microsoft AI MVP 相關公開貢獻摘要。"
>
  <section class="list-hero">
    <p class="eyebrow">Microsoft AI MVP</p>
    <h1>AI 應用與 Microsoft 技術貢獻</h1>
    <p class="lede">Azure OpenAI、Azure Machine Learning、Azure AI、Bot Framework、Semantic Kernel 與生成式 AI 應用開發分享。</p>
    <dl class="stat-strip" aria-label="MVP 貢獻統計">
      <div>
        <dt>Microsoft 相關分享</dt>
        <dd>{microsoftContributions.length}</dd>
      </div>
      <div>
        <dt>技術分類</dt>
        <dd>{products.length}</dd>
      </div>
      <div>
        <dt>出版/寫作</dt>
        <dd>{books.length + writing.length}</dd>
      </div>
    </dl>
  </section>

  <section class="page-section overview-grid" aria-label="Microsoft 技術分類">
    {products.map((product) => (
      <article class="metric-card">
        <h2>{product}</h2>
        <p>{microsoftContributions.filter((entry) => entry.data.microsoftProducts.includes(product)).length} 筆公開分享。</p>
      </article>
    ))}
  </section>

  <section class="page-section" aria-labelledby="recent-mvp-title">
    <div class="section-heading">
      <p class="eyebrow">Recent</p>
      <h2 id="recent-mvp-title">近期 Microsoft 相關貢獻</h2>
    </div>
    <div class="record-list">
      {recentMicrosoft.map((entry) => (
        <article class="record-row">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <div>
            <h3>
              <a href={withBase(entry.data.legacyPath)}>{entry.data.title.zh || entry.data.title.en}</a>
              {entry.data.title.en && entry.data.title.en !== (entry.data.title.zh || entry.data.title.en) && (
                <span class="record-title-en" lang="en">{entry.data.title.en}</span>
              )}
            </h3>
            <p>{entry.data.event}</p>
            <ul class="inline-meta">
              <li>{entry.data.microsoftProducts.join(' / ')}</li>
              <li>{entry.data.evidence.length} proof</li>
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section card-grid" aria-label="其他 MVP 佐證">
    <article class="metric-card">
      <h2>出版</h2>
      <p>{books.length} 本生成式 AI 與 Microsoft AI 技術相關著作。</p>
    </article>
  </section>
</BaseLayout>
