---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../utils/format';
import { withBase } from '../utils/url';

type ContributionEntry = CollectionEntry<'contributions'>;

const contributions = ((await getCollection('contributions')) as ContributionEntry[])
  .sort((a: ContributionEntry, b: ContributionEntry) => b.data.date.getTime() - a.data.date.getTime());
const microsoftRelated = contributions.filter((entry) => entry.data.microsoftProducts.length > 0);
const needsSummary = contributions.filter((entry) => !entry.data.summary.zh && !entry.data.summary.en);
const weakProof = contributions.filter((entry) => entry.data.evidence.length < 2);
const latest = contributions.slice(0, 24);
---

<BaseLayout
  title="MVP 2026 更新索引 | 大魔術熊貓工程師"
  description="Ko Ko 大魔術熊貓工程師的 MVP 更新資料索引與 proof 狀態檢查。"
  noindex={true}
>
  <section class="list-hero">
    <p class="eyebrow">MVP Update Index</p>
    <h1>MVP 2026 更新索引</h1>
    <p class="lede">近期公開貢獻、Microsoft 技術分類與資料完整度檢查。</p>
    <dl class="stat-strip" aria-label="資料完整度統計">
      <div>
        <dt>Microsoft 相關</dt>
        <dd>{microsoftRelated.length}</dd>
      </div>
      <div>
        <dt>待補摘要</dt>
        <dd>{needsSummary.length}</dd>
      </div>
      <div>
        <dt>Proof 少於 2</dt>
        <dd>{weakProof.length}</dd>
      </div>
    </dl>
  </section>

  <section class="page-section" aria-labelledby="latest-proof-title">
    <div class="section-heading">
      <p class="eyebrow">Checklist</p>
      <h2 id="latest-proof-title">近期資料檢查</h2>
    </div>
    <div class="record-list">
      {latest.map((entry) => {
        const missing: string[] = [];
        if (!entry.data.summary.zh && !entry.data.summary.en) missing.push('摘要');
        if (entry.data.evidence.length < 2) missing.push('proof');
        if (entry.data.microsoftProducts.length === 0) missing.push('Microsoft 分類');
        return (
          <article class="record-row">
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            <div>
              <h3><a href={withBase(entry.data.legacyPath)}>{entry.data.title.zh || entry.data.title.en}</a></h3>
              <p>{entry.data.event}</p>
              <ul class="inline-meta">
                <li>{entry.data.evidence.length} proof</li>
                <li>{entry.data.microsoftProducts.length > 0 ? entry.data.microsoftProducts.join(' / ') : '未標 Microsoft 技術'}</li>
                <li>{missing.length > 0 ? `待補：${missing.join('、')}` : '完整'}</li>
              </ul>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
