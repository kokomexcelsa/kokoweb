---
import { normalizeCurrentPath, withBase } from '../utils/url';

const navItems = [
  { href: '/index.html', label: '首頁' },
  { href: '/speech.html', label: '演講' },
  { href: '/portfolio.html', label: '作品集' },
  { href: '/about.html', label: '關於' }
];
const currentPath = normalizeCurrentPath(Astro.url.pathname);
---

<header class="site-header">
  <a class="brand" href={withBase('/index.html')} aria-label="大魔術熊貓工程師首頁">
    <img class="brand-mark" src={withBase('/img/panda-logo.jpg')} alt="大魔術熊貓工程師 logo" width="42" height="42" loading="eager" />
    <span class="brand-text">
      <strong>大魔術熊貓工程師</strong>
      <small>Ko Ko</small>
    </span>
  </a>
  <nav class="site-nav" aria-label="主要導覽">
    {navItems.map((item) => <a href={withBase(item.href)} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</header>
